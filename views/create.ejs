      <div class="form-group col">
        <label>श्रेणी</label>
        <select name="category">
          <option value="स्थानीय निकाय चुनाव">स्थानीय निकाय/सरपंच चुनाव</option>
          <option value="राष्ट्रीय राजनीति">राष्ट्रीय राजनीति</option>
          <option value="सामाजिक मुद्दे">सामाजिक व जनहित मुद्दे</option>
        </select>
      </div>
      <div class="form-group col">
        <label>जिला</label>
        <input type="text" name="district" placeholder="उदा. नागौर, जयपुर, हनुमानगढ़" required>
      </div>
      <div class="form-group col">
        <label>समिति / ग्राम पंचायत</label>
        <input type="text" name="samiti" placeholder="उदा. कुचामन, संगरिया" required>
      </div>
    </div>

    <div class="form-group">
      <label>उम्मीदवार / विकल्प (कम से कम 2)</label>
      <div id="optionsContainer">
        <input type="text" name="options" placeholder="विकल्प 1" required class="mb-2">
        <input type="text" name="options" placeholder="विकल्प 2" required class="mb-2">
      </div>
      <button type="button" id="addOptionBtn" class="btn btn-outline btn-sm">+ और विकल्प जोड़ें</button>
    </div>

    <button type="submit" class="btn btn-primary btn-block">पोल पब्लिश करें</button>
  </form>
</div>

<script>
  document.getElementById('addOptionBtn').addEventListener('click', () => {
    const container = document.getElementById('optionsContainer');
    const input = document.createElement('input');
    input.type = 'text';
    input.name = 'options';
    input.placeholder = `विकल्प ${container.children.length + 1}`;
    input.className = 'mb-2';
    input.required = true;
    container.appendChild(input);
  });
</script>

<%- include('partials/footer') %>